{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Provides various configurable tweaks to respawning such as spawning at random nearby structures instead of a set spawnpoint",
  "authors": ["Strikeless"],
  "contact": {
    "issues": "https://github.com/Strikeless/minecraft-adventurers-respawns/issues",
    "sources": "https://github.com/Strikeless/minecraft-adventurers-respawns"
  },
  "license": "LGPL-3.0-or-later",
  "icon": "assets/adventurers-respawns/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "io.github.strikeless.adventurersrespawns.client.AdventurersRespawnsClient"
    ],
    "main": [
      "io.github.strikeless.adventurersrespawns.main.AdventurersRespawns"
    ],
    "modmenu": [
      "io.github.strikeless.adventurersrespawns.client.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "adventurers-respawns.mixins.json",
    {
      "config": "adventurers-respawns.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "minecraft": "${minecraft}",
    "fabricloader": ">=0.17",
    "fabric": "*",
    "yet_another_config_lib_v3": ">=3"
  }
}
